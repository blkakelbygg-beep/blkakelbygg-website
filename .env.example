# Copy this file to .env.local and fill in your real values.

# Public site URL, used for canonical links, sitemap.xml and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://blkakelbygg.se

# Resend (https://resend.com) – powers the contact form on /kontakta-oss.
# 1. Create a free Resend account and an API key: https://resend.com/api-keys
# 2. Paste the key below.
RESEND_API_KEY=

# Sender address for outgoing emails. Until you verify your own domain in
# Resend, you must use the shared "onboarding@resend.dev" sender - it works
# immediately but Resend recommends verifying blkakelbygg.se for production
# (Resend dashboard → Domains). Once verified, change this to e.g.
# "BL Kakel & Bygg AB <offert@blkakelbygg.se>".
RESEND_FROM_EMAIL="BL Kakel & Bygg AB <onboarding@resend.dev>"

# Where contact-form submissions should be delivered.
RESEND_TO_EMAIL=kontakt@blkakelbygg.se
